rm /etc/passwd
write generated/passwd /etc/passwd
set_inode_field /etc/passwd uid 0
set_inode_field /etc/passwd gid 0
set_inode_field /etc/passwd mode 0100644
rm /etc/shadow
write generated/shadow /etc/shadow
set_inode_field /etc/shadow uid 0
set_inode_field /etc/shadow gid 0
set_inode_field /etc/shadow mode 0100600
rm /etc/default/dropbear
write generated/dropbear.conf /etc/default/dropbear
set_inode_field /etc/default/dropbear uid 0
set_inode_field /etc/default/dropbear gid 0
set_inode_field /etc/default/dropbear mode 0100644
mkdir /home/root/.ssh
set_inode_field /home/root/.ssh uid 0
set_inode_field /home/root/.ssh gid 0
set_inode_field /home/root/.ssh mode 040700
write generated/authorized_keys /home/root/.ssh/authorized_keys
set_inode_field /home/root/.ssh/authorized_keys uid 0
set_inode_field /home/root/.ssh/authorized_keys gid 0
set_inode_field /home/root/.ssh/authorized_keys mode 0100600
set_inode_field /etc/dropbear uid 0
set_inode_field /etc/dropbear gid 0
set_inode_field /etc/dropbear mode 040700
write generated/authorized_keys /etc/dropbear/authorized_keys
set_inode_field /etc/dropbear/authorized_keys uid 0
set_inode_field /etc/dropbear/authorized_keys gid 0
set_inode_field /etc/dropbear/authorized_keys mode 0100600
write generated/host_key /etc/dropbear/classe100x_ecdsa_host_key
set_inode_field /etc/dropbear/classe100x_ecdsa_host_key uid 0
set_inode_field /etc/dropbear/classe100x_ecdsa_host_key gid 0
set_inode_field /etc/dropbear/classe100x_ecdsa_host_key mode 0100600
symlink /etc/rc5.d/S98dropbear ../init.d/dropbear
set_inode_field /etc/rc5.d/S98dropbear uid 0
set_inode_field /etc/rc5.d/S98dropbear gid 0
